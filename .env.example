# Configuração da Aplicação
PORT=3333
NODE_ENV=development
LOG_LEVEL=info

# Banco de Dados PostgreSQL (Host: porta 5433 para evitar conflitos na máquina local)
DATABASE_URL="postgresql://marketplace_user:marketplace_pass@localhost:5433/marketplace_db?schema=public"

# Cache e Filas (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Feature Flags
FEATURE_ASYNC_PAYMENT=true

# Observabilidade
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

