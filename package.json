{
  "name": "marketplace-gt4",
  "version": "1.0.0",
  "description": "Projeto Final Full Cycle - Marketplace como Monolito Modular",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "lint:openapi": "spectral lint docs/openapi.yaml",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx scripts/seed.ts",
    "seed:100k": "tsx scripts/seed-100k.ts",
    "test:k6:smoke": "./scripts/run-k6.sh scripts/k6/01-smoke.js",
    "test:k6:load": "./scripts/run-k6.sh scripts/k6/02-load.js",
    "test:k6:stress": "./scripts/run-k6.sh scripts/k6/03-stress.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.12.14",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.11.1",
    "@types/node": "^20.14.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.57.0",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
